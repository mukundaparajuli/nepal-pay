{
  "name": "nepal-payments",
  "version": "0.1.0",
  "private": true,
  "description": "Stateless Nepal payment gateway SDK monorepo",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:bun": "bun test tests/framework/hono.bun.test.ts",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck && tsc -p tests",
    "clean": "pnpm -r clean",
    "release:dry": "pnpm build && pnpm -r publish --dry-run --no-git-checks --access public",
    "release": "pnpm build && pnpm -r publish --no-git-checks --access public"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^20.14.0",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "esbuild": "^0.21.5",
    "eslint": "^9.4.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.2",
    "supertest": "^7.3.1",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
